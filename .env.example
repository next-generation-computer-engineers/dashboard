# Firebase web client
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional Firebase Admin (service account). Onboarding APIs work without this
# using the caller's ID token + Firestore REST.
# FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Resend — sends onboarding invite emails
RESEND_API_KEY=
# Defaults to Resend test sender if unset:
# ONBOARDING_FROM_EMAIL=CENG Onboarding <beth.t@example.com>

# DocuSeal — free shared form link (no API key required)
NEXT_PUBLIC_DOCUSEAL_FORM_SRC=https://docuseal.com/d/kn2Uj5bNhsHCyx
DOCUSEAL_TEMPLATE_ID=6377250
# Optional paid API:
# DOCUSEAL_API_KEY=
# DOCUSEAL_WEBHOOK_SECRET=

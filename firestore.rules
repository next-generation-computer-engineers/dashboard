rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.memberId;
    }

    function linkedMember() {
      return get(/databases/$(database)/documents/members/$(memberDoc()));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && linkedMember().data.roleIds.hasAny(['role_admin']);
    }

    function canOnboard() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && linkedMember().data.roleIds.hasAny([
          'role_admin',
          'role_core_team',
          'role_vp_onboarding',
          'role_vp_training'
        ]);
    }

    match /members/{memberId} {
      allow read: if signedIn();

      allow update: if signedIn()
        && request.auth.uid == resource.data.authUid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['bio', 'phone', 'preferredName', 'linkedIn', 'portfolio', 'pfpUrl', 'volunteerHoursUrl', 'updatedAt', 'authUid', 'emails']);

      // Volunteer marks own forms signed / needs_review
      allow update: if signedIn()
        && request.auth.uid == resource.data.authUid
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['onboarding', 'onboardingStatus', 'updatedAt'])
        && resource.data.onboardingStatus in ['not_started', 'in_progress']
        && request.resource.data.onboardingStatus in ['in_progress', 'needs_review'];

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['authUid', 'updatedAt', 'pfpUrl', 'emails']);

      allow create: if isAdmin() || canOnboard();
      allow update: if isAdmin() || canOnboard();
      allow delete: if isAdmin() || canOnboard();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || canOnboard());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin() || canOnboard();
    }

    match /roles/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /teams/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /sessions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /classes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /classAssignments/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /onboardingEvents/{id} {
      allow read: if isAdmin() || canOnboard();
      allow create: if canOnboard();
      allow update, delete: if false;
    }

    match /meta/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
